{
  "name": "framespace",
  "productName": "Framespace",
  "version": "1.0.1",
  "private": true,
  "description": "HyperFrames 工作台 · Windows 桌面版",
  "author": "Framespace",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "test": "node tests/helpers.test.cjs",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.framespace.app",
    "productName": "Framespace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "vendor/**/*",
      "index.html",
      "app.js",
      "desktop.js",
      "desktop.css",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Framespace-${version}.exe"
    }
  }
}
