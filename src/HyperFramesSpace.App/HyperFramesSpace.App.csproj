<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>3.0.0</Version>
    <Product>HyperFramesSpace</Product>
    <AssemblyTitle>HyperFramesSpace</AssemblyTitle>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyperFramesSpace.Core\HyperFramesSpace.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\ui\**\*" CopyToOutputDirectory="PreserveNewest" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\vendor\**\*" CopyToOutputDirectory="PreserveNewest" Link="vendor\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\assets\icon.ico" CopyToOutputDirectory="PreserveNewest" Link="icon.ico" />
  </ItemGroup>
</Project>
