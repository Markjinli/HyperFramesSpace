<Window x:Class="HyperFramesSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HyperFramesSpace"
        Height="920" Width="1480"
        MinWidth="1120" MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0A0D12"
        Loaded="OnLoaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0A0D12"/>
</Window>
